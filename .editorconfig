# SPDX-License-Identifier: GPL-3.0-or-later
# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go is gofmt-formatted with tabs.
[*.go]
indent_style = tab

# Makefiles require tabs; shell scripts follow the same convention.
[{Makefile,*.mk,*.sh}]
indent_style = tab
